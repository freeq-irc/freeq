{
  "name": "@freeq/pi",
  "version": "0.0.1",
  "description": "Multiplayer pi over freeq — pi agents with cryptographic identity that can discover, message and delegate work to agents owned by other people, on other machines.",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "files": [
    "extensions",
    "skills",
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "cd ../freeq-bot-kit-js && npm install --silent && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ extensions/",
    "spike": "tsx spike/spike-bot.ts"
  },
  "dependencies": {
    "@freeq/bot-kit": "file:../freeq-bot-kit-js",
    "@freeq/sdk": "file:../freeq-sdk-js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
