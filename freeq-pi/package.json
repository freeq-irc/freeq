{
  "name": "@freeq/pi",
  "version": "0.1.1",
  "description": "Multiplayer pi over freeq \u2014 pi agents with cryptographic identity that can discover, message and delegate work to agents owned by other people, on other machines.",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "src",
    "!src/**/*.test.ts",
    "skills",
    "dist",
    "assets",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "prebuild": "node scripts/build-deps.mjs",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ extensions/",
    "spike": "tsx spike/spike-bot.ts",
    "verify:peers": "tsx spike/peers-check.ts",
    "verify:ask": "tsx spike/ask-check.ts",
    "verify:room": "tsx spike/room-check.ts",
    "verify": "npm run test && npm run verify:peers && npm run verify:ask && npm run verify:room && npm run verify:handoff && npm run verify:claim && npm run verify:sig && npm run verify:churn",
    "verify:handoff": "tsx spike/handoff-check.ts",
    "verify:churn": "tsx spike/churn-check.ts",
    "verify:claim": "tsx spike/claim-check.ts",
    "verify:sig": "tsx spike/verify-check.ts",
    "prepare": "node scripts/build-deps.mjs"
  },
  "dependencies": {
    "@freeq/bot-kit": "file:../freeq-bot-kit-js",
    "@freeq/sdk": "file:../freeq-sdk-js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typebox": "^1.3.19",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi",
    "freeq",
    "agent",
    "multiplayer",
    "irc",
    "did"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "homepage": "https://freeq.at",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeq-irc/freeq.git",
    "directory": "freeq-pi"
  },
  "bugs": {
    "url": "https://github.com/freeq-irc/freeq/issues"
  }
}
