[0.000, "o", "\u001b[2m   irc.freeq.at and irc.zerosum.org — different operators, no shared account.\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[1m$ curl -s https://irc.freeq.at/act/01M1PZGGZNXKM4MKFZJ22RQ1YG | sed -e 's/<[^>]*>/ /g' | grep -E 'crossed an ownership|relayed via' | sed 's/  */ /g;s/^ //' | head -3\u001b[0m\r\n"]
[0.586, "o", "This work crossed an ownership boundary: 3 distinct signers, relayed between servers, every step signed. \r\nsigned by did:key:z6Mkup…71zakf5W · relayed via 7e2a8c3a61bd06…b077ece3 \r\nsigned by did:key:z6Mkup…71zakf5W · relayed via 7e2a8c3a61bd06…b077ece3 \r\n"]
