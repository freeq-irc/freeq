[Unit]
Description=FreeQ IRC Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{REPO_DIR}}
# All server options live in the config file; edit it and restart.
# A flag added here overrides the file (CLI > env > file > default).
ExecStart={{REPO_DIR}}/target/release/freeq-server --config /etc/freeq/server.toml
EnvironmentFile=-/etc/freeq/secrets
Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
# ProtectSystem=strict leaves /tmp read-only, and SQLite needs temp scratch
# space when a schema migration builds an index over a large table — without
# this, such a startup dies with "disk I/O error". A private tmpfs is also
# just better isolation.
PrivateTmp=true
ReadWritePaths=/var/lib/freeq
ReadOnlyPaths=/etc/letsencrypt

[Install]
WantedBy=multi-user.target
