{
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:freeq:freeq",
            "tool": "freeq_hook",
            "input": {
              "hook_event_name": "UserPromptSubmit",
              "prompt": "${prompt}"
            },
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:freeq:freeq",
            "tool": "freeq_hook",
            "input": {
              "hook_event_name": "PreToolUse",
              "tool_name": "${tool_name}",
              "command": "${tool_input.command}",
              "file_path": "${tool_input.file_path}",
              "action": "${tool_input.action}",
              "to": "${tool_input.to}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:freeq:freeq",
            "tool": "freeq_hook",
            "input": {
              "hook_event_name": "PostToolUse",
              "tool_name": "${tool_name}",
              "command": "${tool_input.command}",
              "response": "${tool_response.stdout}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:freeq:freeq",
            "tool": "freeq_hook",
            "input": {
              "hook_event_name": "Stop",
              "last_assistant_message": "${last_assistant_message}"
            }
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:freeq:freeq",
            "tool": "freeq_hook",
            "input": {
              "hook_event_name": "TaskCreated",
              "task_id": "${task_id}",
              "task_subject": "${task_subject}",
              "task_description": "${task_description}",
              "teammate_name": "${teammate_name}"
            }
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:freeq:freeq",
            "tool": "freeq_hook",
            "input": {
              "hook_event_name": "TaskCompleted",
              "task_id": "${task_id}",
              "task_subject": "${task_subject}"
            }
          }
        ]
      }
    ]
  }
}
