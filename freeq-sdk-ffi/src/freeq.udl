namespace freeq {
    // The identity-claim rule — what a client can honestly say about who
    // someone is. Computed here, from spec/identity-claims.json, so every
    // native client renders the same answer the web client does. Clients
    // pass what they see (a row's tags, the roster, the lookup state) and
    // render what comes back; no client computes a state or owns a string.
    IdentityClaim claim_for_message(MessageClaimInput input);
    IdentityClaim claim_for_person(PersonClaimInput input);
    IdentityClaim claim_for_sender(MessageClaimInput input, PersonLookup lookup);
    u64 identity_stamping_epoch_unix();
};

// The six honest answers about who someone is.
enum IdentityClaimState {
    "AtProtocol",
    "SelfIssued",
    "Relayed",
    "Guest",
    "LookingUp",
    "Unknown",
};

// What has been done about finding out who someone is.
enum PersonLookup {
    "NotAsked",
    "InFlight",
    "NoAccount",
    "NoSuchNick",
    "TimedOut",
};

// Inputs for a message row: the row's own tags, and the live room — never a
// stored cache.
dictionary MessageClaimInput {
    string? account;
    string? origin;
    boolean sender_present;
    string? sender_live_did;
    u64? row_time_unix;
};

// Inputs for a person surface. A first-hand binding and seen-only-via-peer
// are mutually exclusive by construction.
dictionary PersonClaimInput {
    string? binding;
    boolean seen_only_via_peer;
    string? via_peer_origin;
    boolean via_peer_had_account;
    PersonLookup lookup;
};

// A finished claim: the state plus everything a surface needs to render it,
// strings already rendered.
dictionary IdentityClaim {
    IdentityClaimState state;
    string? did;
    string? origin;
    string? label;
    string? line;
    boolean shows_mark;
    boolean is_pending;
    boolean needs_key_card;
};

dictionary IrcMessage {
    string from_nick;
    string target;
    string text;
    string? msgid;
    string? reply_to;
    string? replaces_msgid;
    string? edit_of;
    string? batch_id;
    string? pin_msgid;
    string? unpin_msgid;
    boolean is_action;
    boolean is_signed;
    i64 timestamp_ms;
    string? account;
    string? origin;
    sequence<ReactionTally> reactions;
    boolean edited;
    string? dm_key;
    CoordinationEvent? coordination;
    sequence<TagEntry> tags;
};

dictionary CoordinationEvent {
    string event_type;
    string? task_id;
    string? phase;
    string? evidence_type;
    string? reference;
    string? payload;
};

dictionary ActEvent {
    string from;
    string target;
    string kind;
    string verb;
    string? did;
    string event_id;
    string task_id;
    sequence<TagEntry> fields;
    string? sig_tag;
    boolean replayed;
    string? dm_key;
};

dictionary ReactionTally {
    string emoji;
    sequence<string> nicks;
};

dictionary IrcMember {
    string nick;
    boolean is_op;
    boolean is_halfop;
    boolean is_voiced;
    string? away_msg;
};

dictionary ChannelTopic {
    string text;
    string? set_by;
};

dictionary TagEntry {
    string key;
    string value;
};

dictionary TagMessage {
    string from;
    string target;
    sequence<TagEntry> tags;
    string? dm_key;
};

[Enum]
interface FreeqEvent {
    Connected();
    Registered(string nick);
    Authenticated(string did);
    AuthFailed(string reason);
    Joined(string channel, string nick);
    Parted(string channel, string nick);
    NickChanged(string old_nick, string new_nick);
    AwayChanged(string nick, string? away_msg);
    Message(IrcMessage msg);
    TagMsg(TagMessage msg);
    Act(ActEvent event);
    Names(string channel, sequence<IrcMember> members);
    TopicChanged(string channel, ChannelTopic topic);
    ModeChanged(string channel, string mode, string? arg, string set_by);
    Kicked(string channel, string nick, string by, string reason);
    UserQuit(string nick, string reason);
    BatchStart(string id, string batch_type, string target);
    BatchEnd(string id);
    ChatHistoryTarget(string nick, string? timestamp, string? partner_did);
    MemberDid(string nick, string did);
    // draft/read-marker (S1): reply to our mark/get, or another of our
    // devices advancing the marker. timestamp null = server reports none.
    ReadMarker(string target, string? timestamp);
    WhoisReply(string nick, string info);
    // The server finished answering a WHOIS: the point at which "no account"
    // becomes an answer rather than an absence.
    WhoisEnd(string nick);
    Notice(string text);
    Disconnected(string reason);
};

callback interface EventHandler {
    void on_event(FreeqEvent event);
};

interface FreeqClient {
    [Throws=FreeqError]
    constructor(string server, string nick, EventHandler handler);

    [Throws=FreeqError]
    void set_web_token(string token);

    [Throws=FreeqError]
    void set_platform(string platform);

    [Throws=FreeqError]
    void set_websocket_url(string url);

    [Throws=FreeqError]
    void connect();

    void disconnect();

    [Throws=FreeqError]
    void join(string channel);

    [Throws=FreeqError]
    void part(string channel);

    [Throws=FreeqError]
    void send_message(string target, string text);

    [Throws=FreeqError]
    void send_raw(string line);

    // Typed senders. Anything that carries a message or mutates one belongs
    // here — send_raw is never signed.

    [Throws=FreeqError]
    void send_tagged(string target, string text, sequence<TagEntry> tags);

    [Throws=FreeqError]
    void react(string target, string emoji, string msgid);

    [Throws=FreeqError]
    void unreact(string target, string emoji, string msgid);

    [Throws=FreeqError]
    void delete_message(string target, string msgid);

    [Throws=FreeqError]
    void edit_message(string target, string msgid, string new_text);

    [Throws=FreeqError]
    void reply(string target, string msgid, string text);

    [Throws=FreeqError]
    void typing_start(string target);

    [Throws=FreeqError]
    void typing_stop(string target);

    [Throws=FreeqError]
    void request_whois(string nick);

    [Throws=FreeqError]
    void set_topic(string channel, string topic);

    [Throws=FreeqError]
    void nick(string new_nick);

    boolean is_connected();

    string? current_nick();
};

dictionary PreKeyBundle {
    string identity_key;
    string signed_pre_key;
    string spk_signature;
    u32 spk_id;
};

dictionary SafetyNumber {
    string number;
};

interface FreeqE2ee {
    constructor();

    [Throws=FreeqError]
    PreKeyBundle generate_keys();

    [Throws=FreeqError]
    PreKeyBundle restore_keys(string ik_secret_b64, string spk_secret_b64);

    [Throws=FreeqError]
    sequence<string> export_keys();

    [Throws=FreeqError]
    void establish_session(string remote_did, string their_ik_b64, string their_spk_b64);

    [Throws=FreeqError]
    string encrypt_message(string remote_did, string plaintext);

    [Throws=FreeqError]
    string decrypt_message(string remote_did, string wire);

    boolean has_session(string remote_did);

    boolean is_encrypted(string text);

    [Throws=FreeqError]
    SafetyNumber get_safety_number(string remote_did);

    [Throws=FreeqError]
    string export_session(string remote_did);

    [Throws=FreeqError]
    void import_session(string remote_did, string json);
};

// ── P2P via iroh ──

[Enum]
interface P2pEvent {
    EndpointReady(string endpoint_id);
    PeerConnected(string peer_id);
    PeerDisconnected(string peer_id);
    DirectMessage(string peer_id, string text);
    Error(string message);
};

callback interface P2pEventHandler {
    void on_p2p_event(P2pEvent event);
};

interface FreeqP2p {
    [Throws=FreeqError]
    constructor(P2pEventHandler handler);

    [Throws=FreeqError]
    string endpoint_id();

    [Throws=FreeqError]
    void connect_peer(string endpoint_id);

    [Throws=FreeqError]
    void send_message(string peer_id, string text);

    sequence<string> connected_peers();

    void shutdown();
};

// ── AV (voice/video calls via MoQ SFU) ──

[Enum]
interface AvEvent {
    Connected();
    Disconnected(string reason);
    ParticipantJoined(string nick, string instance);
    ParticipantLeft(string nick, string instance);
    AudioTrackStarted(string nick);
    AudioTrackStopped(string nick);
    VideoTrackStarted(string nick);
    VideoTrackStopped(string nick);
    // BGRA frame from a remote participant. Swift renders via AVSampleBufferDisplayLayer.
    VideoFrame(string nick, sequence<u8> bgra, u32 width, u32 height);
    // Screen-share broadcasts ride a separate MoQ path ({peer}/screen — the
    // same convention as the web client), so they get their own events and
    // can run alongside the camera track.
    ScreenTrackStarted(string nick);
    ScreenTrackStopped(string nick);
    ScreenFrame(string nick, sequence<u8> bgra, u32 width, u32 height);
    // ── R1 interface freeze (DESIGN-APP-OF-THE-YEAR Track R) ──
    // Per-participant playout level, 0.0–1.0, ~10 Hz while they speak.
    // Drives remote active-speaker highlighting. Emission lands with the
    // playout tap; the shape is frozen so clients can build against it.
    AudioLevel(string nick, float level);
    // Transport dropped; the SDK is retrying (attempt count, 1-based).
    Reconnecting(u32 attempt);
    // Transport restored after Reconnecting.
    Reconnected();
    Error(string message);
};

// An audio output device for the speaker picker.
dictionary AvAudioDevice {
    string id;
    string name;
    boolean is_default;
};

callback interface AvEventHandler {
    void on_av_event(AvEvent event);
};

interface FreeqAv {
    [Throws=FreeqError]
    constructor(string server_url, string session_id, string nick, string instance_id, AvEventHandler handler);

    void leave();

    // Mute toggles whether the locally-captured mic samples are sent (vs silence).
    // Track stays live so peers don't see AudioTrackStopped.
    void set_muted(boolean muted);

    // Enable/disable the local video track. When enabled, the encoder pipeline
    // pulls frames pushed via push_video_frame(). When disabled, the track is
    // removed from the broadcast and peers see VideoTrackStopped.
    [Throws=FreeqError]
    void set_camera_enabled(boolean enabled);

    // Swift-driven camera capture. Each call queues a BGRA frame for the
    // encoder pipeline. Caller is responsible for capture cadence; the
    // encoder will pull the most-recent queued frame.
    void push_video_frame(sequence<u8> bgra, u32 width, u32 height, u64 timestamp_us);

    // Swift-driven mic capture. Each call queues mono 48 kHz f32 samples
    // for the Opus encoder. iroh-live's audio input backend isn't viable
    // on iOS, so capture happens in Swift (AVAudioEngine).
    void push_audio_frame(sequence<f32> samples);

    // Publish (true) or retract (false) a second, video-only broadcast at
    // `{our-path}/screen` — the web client's screen-share convention. This
    // is independent of the camera track, so camera + screen can run
    // simultaneously.
    [Throws=FreeqError]
    void set_screen_enabled(boolean enabled);

    // Swift-driven screen capture (ScreenCaptureKit). Same contract as
    // push_video_frame, but feeds the /screen broadcast's encoder.
    void push_screen_frame(sequence<u8> bgra, u32 width, u32 height, u64 timestamp_us);

    // Remote audio plays through the Rust audio backend (cpal), so the
    // speaker picker lives here, not in AVFoundation.
    sequence<AvAudioDevice> list_output_devices();

    // Route remote audio to a specific output device (id from
    // list_output_devices). null = system default.
    [Throws=FreeqError]
    void set_output_device(string? device_id);

    boolean is_connected();
};

[Error]
enum FreeqError {
    "ConnectionFailed",
    "NotConnected",
    "SendFailed",
    "InvalidArgument",
};
