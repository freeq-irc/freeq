// dep-audit — triage a dependency vulnerability and patch it safely.
//
// audit (read-only): run cargo audit + npm audit, pick ONE actionable finding.
// patch: bump/patch the dependency with the smallest viable change.
// verify: authoritative CI-mirror gate (goal_gate) — proves nothing broke.
// pr_body: report the advisory, the bump, and the verification.
digraph DepAudit {
    graph [goal="Resolve one actionable dependency security advisory in freeq with the smallest viable version bump or patch, and prove the build + tests still pass. Never force a major/breaking upgrade blindly — if the only fix is breaking, report it instead of shipping it."]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    audit     [shape=box, label="Audit + triage", model="claude-sonnet-5-5", prompt="@prompts/audit.md", thread_id="dep", fidelity="full", reasoning_effort="medium", timeout="1800s"]
    patch     [shape=box, label="Patch dep",      model="claude-sonnet-5-5", prompt="@prompts/patch.md", thread_id="dep", fidelity="full", reasoning_effort="high", timeout="2400s"]
    verify    [shape=parallelogram, label="CI gate", script="bash .fabro/verify.sh", goal_gate=true, retry_target="patch", max_retries=2, timeout="3600s"]
    pr_body   [shape=tab, label="PR description", model="claude-sonnet-5-5", prompt="@prompts/pr_body.md", thread_id="dep", fidelity="full"]

    // A failed working stage must not fall through to the next one: with
    // plain unconditional edges an LLM outage "succeeded" by running the CI
    // gate on unchanged main. Each such stage advances only on success and
    // otherwise drops to `abort`, a failing goal gate, so the run ends FAILED
    // (and says so in #freeq-dev). Fabro 0.254 requires the unconditional
    // fallback edge, and ignores graph-level on_failure="exit".
    abort [shape=parallelogram, label="Stage failed", script="echo 'a working stage failed - see fabro events' >&2; exit 1", goal_gate=true, max_retries=0]
    abort -> exit

    start -> audit
    audit -> patch [condition="outcome=succeeded"]
    audit -> abort
    patch -> verify [condition="outcome=succeeded"]
    patch -> abort
    verify -> pr_body -> exit
}
