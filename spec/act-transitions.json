{
  "_readme": [
    "The task lifecycle: which move is legal, from which state, by whom.",
    "Written by hand. Both SDKs load this file and must reach the same verdict on every sequence below;",
    "the Rust checker compiles it in, the TypeScript package carries a byte-identical copy a test pins.",
    "Adding a task kind means adding an entry here first — an event whose kind this file does not list is refused,",
    "so the rules a server enforces are never wider than the rules that were written down.",
    "`opens` names the verb that CREATES a task of this kind, and the state it lands in — `directed` when the",
    "message names a recipient in act-to, `open` when it does not. The transitions below are moves on a task",
    "that already exists; without `opens` a server would refuse the one message that starts everything.",
    "Any logged-in sender may open, so an opener has no `who`: opening is what makes the sender the offerer.",
    "An opener carries no act-id — its own event id is the task's id — so one that names a task is an illegal step.",
    "`who` names the role a sender must hold: offerer, offeree, assignee, anyone (any logged-in sender), or",
    "system (the server itself — expiry only). act-caps is a self-declared hint — stored, filterable, signed,",
    "never checked here. `from` is one state, a list of states, or",
    "`*nonterminal` for every state that is not terminal. `before_deadline` is data; the comparison is code."
  ],
  "version": 1,
  "kinds": {
    "handoff": {
      "opens": { "verb": "offer", "directed": "offered", "open": "open" },
      "terminal": ["completed", "failed", "cancelled", "declined", "expired"],
      "transitions": [
        { "verb": "accept", "from": "offered", "to": "assigned", "who": "offeree", "before_deadline": true },
        { "verb": "decline", "from": "offered", "to": "declined", "who": "offeree" },
        { "verb": "claim", "from": "open", "to": "assigned", "who": "anyone", "before_deadline": true },
        { "verb": "progress", "from": "assigned", "to": "assigned", "who": "assignee" },
        { "verb": "complete", "from": "assigned", "to": "completed", "who": "assignee" },
        { "verb": "fail", "from": "assigned", "to": "failed", "who": "assignee" },
        { "verb": "cancel", "from": ["offered", "assigned", "open"], "to": "cancelled", "who": "offerer" },
        { "verb": "expire", "from": "*nonterminal", "to": "expired", "who": "system" }
      ]
    }
  },
  "refusals": {
    "unknown-kind": "The kind is not in this file. Adding a kind means updating this file first.",
    "unknown-verb": "The kind lists no transition with this verb.",
    "terminal-task": "The task is finished. A later event never un-applies an earlier one.",
    "illegal-step": "The verb is not legal from the task's current state.",
    "wrong-sender": "The sender does not hold the role this transition requires.",
    "deadline-passed": "The event was minted after the offer's deadline, beyond the clock tolerance."
  },
  "deadline_rule": {
    "_note": [
      "The clock is the incoming event's own id: a ULID embeds the millisecond its signer minted it,",
      "so every verifier compares the same number instead of its own wall clock.",
      "The tolerance is the one client-minted ids already get — federated machines are not in sync."
    ],
    "tolerance_ms": 120000
  },
  "opening_sequences": [
    {
      "name": "a directed offer opens a task in the offered state",
      "kind": "handoff",
      "verb": "offer",
      "directed": true,
      "expect": "offered"
    },
    {
      "name": "an offer naming nobody opens a claimable task",
      "kind": "handoff",
      "verb": "offer",
      "directed": false,
      "expect": "open"
    },
    {
      "name": "an opener that names an existing task is refused",
      "kind": "handoff",
      "verb": "offer",
      "directed": true,
      "names_task": true,
      "expect_refused": "illegal-step"
    },
    {
      "name": "a verb that neither opens nor moves a task is refused",
      "kind": "handoff",
      "verb": "post",
      "directed": false,
      "expect_refused": "unknown-verb"
    },
    {
      "name": "a verb that moves a task cannot open one",
      "kind": "handoff",
      "verb": "accept",
      "directed": true,
      "expect_refused": "illegal-step"
    },
    {
      "name": "an opener for a kind this file does not list is refused",
      "kind": "bounty",
      "verb": "offer",
      "directed": false,
      "expect_refused": "unknown-kind"
    }
  ],
