# freeq server configuration
# Copy to .env and edit

# Server name (appears in IRC messages)
SERVER_NAME=freeq

# Message of the Day
MOTD=Welcome to freeq — IRC with AT Protocol identity

# Server operator DIDs (comma-separated, auto-granted oper on connect)
OPER_DIDS=

# Server operator password (for OPER command)
OPER_PASSWORD=

# Shared secret between server and a standalone auth broker (HMAC-SHA256).
# Leave unset to use the embedded broker (default). Setting this DISABLES
# embedded mode — only set it if you run freeq-auth-broker as a service.
# Generate with: openssl rand -hex 32
BROKER_SHARED_SECRET=

# GitHub OAuth (for credential verification)
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Private media via AT Protocol spaces (docs/PRIVATE-MEDIA-SPACES.md).
# Leave unset to keep the feature off. The DID is an account for this server
# on a spaces-capable PDS.
FREEQ_MEDIA_SPACE_DID=
FREEQ_MEDIA_SPACE_PASSWORD=
